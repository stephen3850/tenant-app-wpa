// Production-ready Prisma schema for TMS
// Implements Multi-Tenancy, Granular RBAC, and Full Rental Lifecycle

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  PAYMENT_DUE
  GRACE_PERIOD
  SUSPENSION_PENDING
  SUSPENDED
  CANCELLED
  ARCHIVED
}

model Organization {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  logo    String?
  address String?

  // Platform Management
  legalName    String?
  tradingName  String?
  regNumber    String?
  taxNumber    String?
  contactEmail String?
  contactPhone String?
  country      String?            @default("Kenya")
  timeZone     String?            @default("Africa/Nairobi")
  status       OrganizationStatus @default(ACTIVE)
  healthScore  Int                @default(100)

  // Subscription Locking & Reactivation
  lockedAt               DateTime?
  lockedById             String?
  suspendedAt            DateTime?
  suspensionReason       String?
  activationOtp          String?
  activationOtpExpiresAt DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  roles            Role[]
  auditLogs        AuditLog[]
  properties       Property[]
  tenants          Tenant[]
  tenantGroups     TenantGroup[]
  leases           Lease[]
  invoices         Invoice[]
  payments         Payment[]
  expenses         Expense[]
  tickets          Ticket[]
  cases            Case[]
  communications   Communication[]
  subscription     Subscription?
  billingInvoices  BillingInvoice[]
  billingPayments  BillingPayment[]
  usageMetrics     UsageMetric[]
  ownerStatements  OwnerStatement[]
  disbursements    Disbursement[]
  reportTemplates  ReportTemplate[]
  savedReports     SavedReport[]
  scheduledReports ScheduledReport[]
  reportExports    ReportExport[]
  roleTemplates    RoleTemplate[]

  // Security Module
  securityIncidents SecurityIncident[]
  securityVisitors  SecurityVisitor[]
  securityPatrols   SecurityPatrol[]
  securityHandovers SecurityShiftHandover[]

  // Records & Compliance
  retentionPolicies RetentionPolicy[]
  complianceRecords ComplianceRecord[]
  recordAccessLogs  RecordAccessLog[]

  // Communications Module
  communicationTemplates CommunicationTemplate[]
  announcements          Announcement[]
  notifications          Notification[]

  // Utility Module
  utilityTypes        UtilityType[]
  utilityMeters       UtilityMeter[]
  utilityReadings     UtilityReading[]
  utilityBillingRules UtilityBillingRule[]

  // User & Access Management
  departments       Department[]
  accessReviews     AccessReview[]
  approvalWorkflows ApprovalWorkflow[]

  // Support & Knowledge Base
  supportCategories SupportCategory[]
  supportTags       SupportTag[]
  supportArticles   SupportArticle[]
  supportDocuments  SupportDocument[]

  // Task Management Module
  tasks    Task[]
  projects Project[]

  // Platform Support
  platformSupportCases SupportCase[]

  // Integrations & Jobs
  platformJobs PlatformJob[]

  // Feature Flags & Config
  featureOverrides           FeatureFlagOverride[]
  collectionSetting          CollectionSetting?
  documents                  Document[]
  paymentAllocations         PaymentAllocation[]
  creditBalances             CreditBalance[]
  tenantLedgers              TenantLedger[]
  mpesaCredential            MpesaCredential?
  mpesaTransactions          MpesaTransaction[]
  expenseCategories          ExpenseCategory[]
  vendors                    Vendor[]
  leaseRenewals              LeaseRenewal[]
  leaseNotices               LeaseNotice[]
  ticketCategories           TicketCategory[]
  caseCategories             CaseCategory[]
  securityIncidentCategories SecurityIncidentCategory[]
  propertyDocuments          PropertyDocument[]
  conversations              Conversation[]
  platformSecurityIncidents  PlatformSecurityIncident[]

  @@map("organizations")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
  LOCKED
  ARCHIVED
}

model User {
  id                    String     @id @default(cuid())
  name                  String?
  email                 String     @unique
  password              String?
  emailVerified         DateTime?
  image                 String?
  phone                 String?
  mailingAddress        String?
  emergencyContactName  String?
  emergencyContactPhone String?
  status                UserStatus @default(ACTIVE)
  lastLoginAt           DateTime?
  mfaEnabled            Boolean    @default(false)
  passwordChangedAt     DateTime?
  preferredLanguage     String?    @default("en")
  preferredTimeZone     String?    @default("UTC")
  marketingOptIn        Boolean    @default(false)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  userRoles UserRole[]
  auditLogs AuditLog[]

  // Activity Tracking
  loginHistory LoginHistory[]

  // Access Reviews
  conductedReviews AccessReview[] @relation("Reviewer")

  // Approvals
  decisions ApprovalDecision[]

  // Property Relations
  managedProperties   Property[] @relation("PropertyManager")
  ownedProperties     Property[] @relation("Landlord")
  caretakerProperties Property[] @relation("Caretaker")

  tickets        Ticket[] @relation("TicketAssignee")
  createdTickets Ticket[] @relation("TicketCreator")

  createdExpenses  Expense[] @relation("ExpenseCreator")
  approvedExpenses Expense[] @relation("ExpenseApprover")

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  assignedTickets  TicketAssignment[]      @relation("AssignedBy")
  attachments      MaintenanceAttachment[]
  comments         TicketComment[]
  ticketActivities TicketActivity[]

  cases          Case[]         @relation("CaseAssignee")
  createdCases   Case[]         @relation("CaseCreator")
  caseActivities CaseActivity[]
  caseEvidence   CaseEvidence[]
  caseDecisions  CaseDecision[]

  // Security Module Relations
  securityRecordedIncidents SecurityIncident[]      @relation("IncidentRecorder")
  securityHandoverIncoming  SecurityShiftHandover[] @relation("IncomingOfficer")
  securityHandoverOutgoing  SecurityShiftHandover[] @relation("OutgoingOfficer")
  securityPatrols           SecurityPatrol[]
  securityActivities        SecurityActivity[]
  securityEvidence          SecurityEvidence[]

  messages      Message[]
  conversations ConversationParticipant[]

  notifications        Notification[]
  createdAnnouncements Announcement[] @relation("AnnouncementCreator")

  recordedReadings UtilityReading[] @relation("ReadingRecorder")
  approvedReadings UtilityReading[] @relation("ReadingApprover")

  // Support & Knowledge Base Relations
  authoredArticles  SupportArticle[]        @relation("ArticleAuthor")
  articleVersions   SupportArticleVersion[]
  uploadedDocuments SupportDocument[]
  documents         Document[]              @relation("DocumentUploader")
  downloadLogs      DownloadLog[]
  propertyDocuments PropertyDocument[]      @relation("PropertyDocumentUploader")

  createdReports AnalyticsReport[] @relation("ReportCreator")

  // Enterprise Reporting
  reportTemplates ReportTemplate[] @relation("ReportCreator")
  savedReports    SavedReport[]    @relation("SavedReportCreator")
  reportExports   ReportExport[]   @relation("ReportExportCreator")

  // Support & Impersonation
  impersonatorSessions ImpersonationSession[] @relation("Impersonator")
  impersonatedSessions ImpersonationSession[] @relation("TargetUser")
  assignedSupportCases SupportCase[]          @relation("SupportAgent")
  createdSupportCases  SupportCase[]          @relation("SupportRequester")

  // Security Center Relations
  investigatedIncidents PlatformSecurityIncident[] @relation("SecurityInvestigator")
  securityTargets       PlatformSecurityIncident[] @relation("SecurityTarget")

  // Task Management Relations
  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks  Task[] @relation("TaskCreator")
  landlordTasks Task[] @relation("TaskLandlord")
  taskComments  TaskComment[]

  // Profile Module Relations
  notificationPreferences NotificationPreference?
  consentRecords          ConsentRecord[]
  sessions                Session[]

  ownerStatements   OwnerStatement[]
  disbursements     Disbursement[]
  favoriteDocuments LandlordFavoriteDocument[]

  // Platform Monitoring Relations
  commandedIncidents       PlatformIncident[]       @relation("IncidentCommander")
  incidentUpdates          PlatformIncidentUpdate[] @relation("IncidentUpdateCreator")
  lastModifiedFeatureFlags FeatureFlag[]

  // Super Admin Relations
  apiTokens SuperAdminApiToken[]

  // Tenant Portal Relation
  tenantProfile Tenant?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  ticketAssignments TicketAssignment[]
  recordAccessLogs  RecordAccessLog[]

  @@index([organizationId])
  @@index([departmentId])
  @@map("users")
}

model Role {
  id             String           @id @default(cuid())
  name           String
  description    String?
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  permissions    RolePermission[]
  userRoles      UserRole[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  approvalSteps  ApprovalStep[]

  @@unique([name, organizationId])
}

model Permission {
  id          String           @id @default(cuid())
  action      String
  subject     String
  description String?
  roles       RolePermission[]

  @@unique([action, subject])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RoleTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  baseRole       String?
  permissions    Json // Array of { action, subject }
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@map("role_templates")
}

model AuditLog {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  action         String
  entity         String
  entityId       String
  oldData        Json?
  newData        Json?
  ipAddress      String?
  userAgent      String?

  // Platform additions
  integrationId String?
  reason        String?

  createdAt DateTime @default(now())
}

model Property {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  propertyCode        String       @unique
  propertyName        String
  propertyType        String
  address             String
  city                String
  county              String
  landlordId          String?
  landlord            User?        @relation("Landlord", fields: [landlordId], references: [id])
  caretakerId         String?
  caretaker           User?        @relation("Caretaker", fields: [caretakerId], references: [id])
  managerId           String?
  manager             User?        @relation("PropertyManager", fields: [managerId], references: [id])
  status              String       @default("ACTIVE")
  description         String?      @db.Text
  acquisitionDate     DateTime?
  propertyValue       Decimal?     @db.Decimal(15, 2)
  ownershipPercentage Decimal?     @default(100) @db.Decimal(5, 2)

  // Payment Details
  paybillNumber String?
  bankName      String?
  accountNumber String?
  accountFormat String?
  customFormat  String?

  // Property Configuration
  numberOfFloors    Int?     @default(1)
  serviceChargeRate Decimal? @default(0) @db.Decimal(12, 2)
  waterUnitRate     Decimal? @db.Decimal(12, 2)
  utilityDueRule    String?  @default("Reading date")
  daysAfterReading  Int?
  nextMonthDay      Int?
  incomeTaxRate     Decimal? @default(0) @db.Decimal(12, 2)
  featuredImage     String?

  units     Unit[]
  expenses  Expense[]
  tickets   Ticket[]
  tasks     Task[]
  documents PropertyDocument[]

  utilityMeters       UtilityMeter[]
  utilityBillingRules UtilityBillingRule[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  leases            Lease[]
  cases             Case[]
  securityIncidents SecurityIncident[]
  complianceRecords ComplianceRecord[]

  @@index([organizationId])
  @@index([landlordId])
  @@index([managerId])
  @@index([caretakerId])
}

enum OccupancyStatus {
  VACANT
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum UnitStatus {
  ACTIVE
  INACTIVE
}

model Unit {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  unitNumber String
  unitCode   String? @unique

  // Classification
  unitType String // Studio, 1BR, 2BR, Penthouse, Shop, Office
  block    String?
  floor    String?

  // Rental
  monthlyRent     Decimal @db.Decimal(12, 2)
  securityDeposit Decimal @db.Decimal(12, 2)
  serviceCharge   Decimal @default(0) @db.Decimal(12, 2)

  // Physical
  bedrooms      Int?
  bathrooms     Int?
  squareFootage Decimal? @db.Decimal(10, 2)

  // Occupancy & Lifecycle
  occupancyStatus OccupancyStatus @default(VACANT)
  status          UnitStatus      @default(ACTIVE)

  leases   Lease[]
  expenses Expense[]
  tickets  Ticket[]
  tasks    Task[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  cases         Case[]
  utilityMeters UtilityMeter[]

  @@index([propertyId])
  @@index([occupancyStatus])
  @@index([unitType])
  @@index([status])
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
  FORMER
}

model Tenant {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  tenantCode     String?      @unique

  // Personal
  firstName   String
  middleName  String?
  lastName    String
  gender      String?
  dateOfBirth DateTime?

  // Identification
  idNumber       String? @unique // Mapping nationalId to existing idNumber
  passportNumber String? @unique

  // Contact
  email            String?
  phone            String  @unique // Mapping phoneNumber to existing phone
  alternativePhone String?

  // Address
  postalAddress String?
  city          String?
  county        String?

  // Emergency Contact
  emergencyName  String?
  emergencyPhone String?
  relationship   String?

  // Employment
  employer   String?
  occupation String?

  // System
  profilePhoto String?
  status       TenantStatus @default(ACTIVE)

  // User Link
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Dates
  moveInDate  DateTime?
  moveOutDate DateTime?

  preferredContactMethod String? @default("EMAIL") // EMAIL, SMS, PHONE
  preferredContactHours  String? // e.g. "9AM-5PM"
  marketingOptIn         Boolean @default(false)

  groupId String?
  group   TenantGroup? @relation(fields: [groupId], references: [id])

  leases            Lease[]
  tickets           Ticket[]
  tasks             Task[]
  cases             Case[]
  documents         Document[]
  payments          Payment[]
  ledgerEntries     TenantLedger[]
  creditBalance     CreditBalance?
  mpesaTransactions MpesaTransaction[]
  securityVisitors  SecurityVisitor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([firstName, lastName])
  @@index([phone])
  @@index([idNumber])
  @@index([tenantCode])
}

model TenantGroup {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  tenants        Tenant[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@map("tenant_groups")
}

enum DocumentCategory {
  LEASE_AGREEMENT
  RECEIPT
  NOTICE
  INSPECTION_REPORT
  MOVE_IN_DOCUMENT
  MOVE_OUT_DOCUMENT
  COMPLIANCE_DOCUMENT
  UTILITY_STATEMENT
  OTHER
}

enum DocumentStatus {
  AVAILABLE
  ARCHIVED
  EXPIRED
}

model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  url         String
  category    DocumentCategory @default(OTHER)
  status      DocumentStatus   @default(AVAILABLE)

  fileType String?
  fileSize Int?

  version    Int       @default(1)
  expiryDate DateTime?

  uploadedById String?
  uploadedBy   User?   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  parentId String?
  parent   Document?  @relation("DocumentVersions", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions Document[] @relation("DocumentVersions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([organizationId])
  @@map("documents")
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
  RENEWED
}

model Lease {
  id             String       @id @default(cuid())
  leaseNumber    String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id])
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  // Financial
  monthlyRent     Decimal @db.Decimal(12, 2)
  securityDeposit Decimal @db.Decimal(12, 2)
  serviceCharge   Decimal @default(0) @db.Decimal(12, 2)
  lateFee         Decimal @default(0) @db.Decimal(12, 2)
  billingDay      Int     @default(1)

  // Dates
  startDate   DateTime
  endDate     DateTime?
  moveInDate  DateTime?
  moveOutDate DateTime?

  // Terms
  paymentFrequency String @default("MONTHLY") // MONTHLY, QUARTERLY, YEARLY
  leaseTermMonths  Int?
  noticePeriodDays Int    @default(30)

  status LeaseStatus @default(ACTIVE)

  // Documents
  signedLeaseUrl    String?
  terminationReason String?

  // Versioning
  previousLeaseId String? @unique
  previousLease   Lease?  @relation("LeaseHistory", fields: [previousLeaseId], references: [id])
  nextLease       Lease?  @relation("LeaseHistory")

  renewals  LeaseRenewal[]
  notices   LeaseNotice[]
  timeline  LeaseEvent[]
  occupants LeaseOccupant[]

  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  payments  Payment[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([unitId])
  @@index([tenantId])
  @@index([status])
  @@index([leaseNumber])
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoiceNumber  String       @unique
  leaseId        String
  lease          Lease        @relation(fields: [leaseId], references: [id])

  // Billing Period
  billingMonth Int
  billingYear  Int

  // Financials
  subtotal    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  amountPaid  Decimal @default(0) @db.Decimal(12, 2)
  balanceDue  Decimal @db.Decimal(12, 2)

  dueDate    DateTime
  issuedDate DateTime?
  status     InvoiceStatus @default(DRAFT)

  lineItems InvoiceLineItem[]
  payments  Payment[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  paymentAllocations PaymentAllocation[]
  tenantLedgers      TenantLedger[]
  mpesaTransactions  MpesaTransaction[]

  @@unique([leaseId, billingMonth, billingYear], name: "lease_billing_period_unique")
  @@index([organizationId])
  @@index([leaseId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoice_line_items")
}

enum PaymentMethod {
  CASH
  MPESA
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REVERSED
  FAILED
}

enum LedgerEntryType {
  INVOICE
  PAYMENT
  CREDIT
  ADJUSTMENT
  REVERSAL
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  leaseId String?
  lease   Lease?  @relation(fields: [leaseId], references: [id])

  amount Decimal       @db.Decimal(12, 2)
  method PaymentMethod
  status PaymentStatus @default(COMPLETED)

  transactionRef String?  @unique
  receiptNumber  String?  @unique
  paymentDate    DateTime @default(now())

  notes String?

  allocations   PaymentAllocation[]
  ledgerEntries TenantLedger[]
  receipt       Receipt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId String?

  @@index([organizationId])
  @@index([tenantId])
  @@index([status])
  @@index([paymentDate])
  @@index([transactionRef])
  @@map("payments")
}

model PaymentAllocation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model CreditBalance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  amount Decimal @default(0) @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt

  @@map("credit_balances")
}

model TenantLedger {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  type        LedgerEntryType
  description String

  debit   Decimal @default(0) @db.Decimal(12, 2)
  credit  Decimal @default(0) @db.Decimal(12, 2)
  balance Decimal @db.Decimal(12, 2) // Running balance

  reference String?

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([tenantId])
  @@map("tenant_ledger")
}

model Receipt {
  id         String   @id @default(cuid())
  paymentId  String   @unique
  payment    Payment  @relation(fields: [paymentId], references: [id])
  receiptUrl String?
  createdAt  DateTime @default(now())
}

model MpesaCredential {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])

  consumerKey    String
  consumerSecret String
  shortCode      String
  passkey        String
  environment    String  @default("sandbox") // sandbox, production
  callbackUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mpesa_credentials")
}

model MpesaTransaction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // Optional link to a specific invoice, though reconciliation handles many
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  merchantRequestId String? @unique
  checkoutRequestId String? @unique

  transactionType    String  @default("STK_PUSH") // STK_PUSH, C2B
  mpesaReceiptNumber String? @unique

  amount      Decimal? @db.Decimal(12, 2)
  phoneNumber String?

  accountReference String? // Used for C2B or STK push reference
  transactionDate  DateTime?

  resultCode Int?
  resultDesc String?

  status String @default("PENDING") // PENDING, SUCCESS, FAILED

  rawCallback Json?

