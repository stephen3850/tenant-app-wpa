  targetUserId String?
  targetUser   User?   @relation("SecurityTarget", fields: [targetUserId], references: [id])

  metadata Json? // For IP, device, etc.

  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("platform_security_incidents")
}

model PlatformSecurityAlert {
  id          String                           @id @default(cuid())
  type        String // FAILED_LOGIN_SPIKE, IMPOSSIBLE_TRAVEL, etc.
  description String
  severity    PlatformSecurityIncidentSeverity
  status      String                           @default("PENDING") // PENDING, SUPPRESSED, LINKED_TO_INCIDENT

  organizationId String?
  userId         String?

  metadata Json?

  createdAt DateTime @default(now())

  @@map("platform_security_alerts")
}

// ==========================================
// Integrations & Jobs Module
// ==========================================

enum IntegrationType {
  FINANCIAL
  COMMUNICATION
  STORAGE
  AUTHENTICATION
}

enum IntegrationProvider {
  MPESA
  STRIPE
  PAYPAL
  TWILIO
  SENDGRID
  AWS_S3
  CLOUDINARY
  GOOGLE_SSO
  MICROSOFT_SSO
}

model PlatformIntegration {
  id          String              @id @default(cuid())
  name        String
  type        IntegrationType
  provider    IntegrationProvider @unique
  description String?
  isEnabled   Boolean             @default(false)
  config      Json? // Encrypted credentials
  isGlobal    Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhooks PlatformWebhook[]
  jobs     PlatformJob[]

  @@map("platform_integrations")
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
  CANCELLED
}

model PlatformJob {
  id       String    @id @default(cuid())
  jobType  String
  status   JobStatus @default(QUEUED)
  priority Int       @default(0)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  integrationId String?
  integration   PlatformIntegration? @relation(fields: [integrationId], references: [id])

  payload    Json?
  result     Json?
  error      String? @db.Text
  stackTrace String? @db.Text

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  startedAt   DateTime?
  completedAt DateTime?
  nextRunAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([organizationId])
  @@map("platform_jobs")
}

model PlatformWebhook {
  id            String              @id @default(cuid())
  integrationId String
  integration   PlatformIntegration @relation(fields: [integrationId], references: [id])

  endpoint    String
  description String?
  secret      String?
  isEnabled   Boolean @default(true)

  lastDeliveryAt DateTime?
  successRate    Float?    @default(0)
  failureRate    Float?    @default(0)

  deliveries PlatformWebhookDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_webhooks")
}

model PlatformWebhookDelivery {
  id        String          @id @default(cuid())
  webhookId String
  webhook   PlatformWebhook @relation(fields: [webhookId], references: [id])

  payload    Json
  response   Json?
  statusCode Int?
  duration   Int? // in ms
  status     String // SUCCESS, FAILED

  createdAt DateTime @default(now())

  @@map("platform_webhook_deliveries")
}

model PlatformScheduledTask {
  id             String    @id @default(cuid())
  name           String    @unique
  description    String?
  cronExpression String
  taskType       String
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  isEnabled      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_scheduled_tasks")
}

// ==========================================
// Feature Flags & Configuration Module
// ==========================================

enum FeatureStatus {
  ENABLED
  DISABLED
  SCHEDULED
  BETA
  EXPERIMENT
}

enum FeatureScope {
  GLOBAL
  ORGANIZATION
  PLAN
  USER_SEGMENT
}

model FeatureFlag {
  id                String        @id @default(cuid())
  name              String
  key               String        @unique
  description       String?
  status            FeatureStatus @default(DISABLED)
  scope             FeatureScope  @default(GLOBAL)
  rolloutPercentage Int           @default(0) // 0 to 100

  config Json? // Optional feature-specific configuration

  activeAt  DateTime?
  expiresAt DateTime?

  lastModifiedById String?
  lastModifiedBy   User?   @relation(fields: [lastModifiedById], references: [id])

  overrides FeatureFlagOverride[]
  versions  FeatureFlagVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_feature_flags")
}

model FeatureFlagOverride {
  id          String      @id @default(cuid())
  flagId      String
  featureFlag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  isEnabled      Boolean @default(true)
  reason         String?
  configOverride Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([flagId, organizationId])
  @@map("platform_feature_overrides")
}

model FeatureFlagVersion {
  id          String      @id @default(cuid())
  flagId      String
  featureFlag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  versionData Json
  reason      String?

  createdById String

  createdAt DateTime @default(now())

  @@map("platform_feature_versions")
}

enum ConfigCategory {
  PLATFORM
  BUSINESS
  SECURITY
  FINANCIAL
  COMMUNICATION
}

model PlatformConfiguration {
  id          String         @id @default(cuid())
  category    ConfigCategory
  key         String         @unique
  value       Json
  description String?
  isSensitive Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_configurations")
}

// ==========================================
// System Health & Monitoring Module
// ==========================================

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

model PlatformIncident {
  id          String           @id @default(cuid())
  title       String
  description String           @db.Text
  severity    IncidentSeverity @default(SEV3)
  status      IncidentStatus   @default(INVESTIGATING)

  commanderId String?
  commander   User?   @relation("IncidentCommander", fields: [commanderId], references: [id])

  startedAt  DateTime  @default(now())
  resolvedAt DateTime?

  postmortem String? @db.Text
  isPublic   Boolean @default(false)

  updates         PlatformIncidentUpdate[]
  affectedSystems PlatformAffectedSystem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_incidents")
}

model PlatformIncidentUpdate {
  id         String           @id @default(cuid())
  incidentId String
  incident   PlatformIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  status  IncidentStatus
  content String         @db.Text

  createdById String
  creator     User   @relation("IncidentUpdateCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@map("platform_incident_updates")
}

model PlatformAffectedSystem {
  id         String           @id @default(cuid())
  incidentId String
  incident   PlatformIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  systemName String // e.g., "M-Pesa Gateway", "Auth Service", "Core API"
  status     String // DEGRADED, DOWN, OPERATIONAL

  @@map("platform_affected_systems")
}

model PlatformStatusEntry {
  id      String @id @default(cuid())
  title   String
  content String @db.Text
  type    String // INCIDENT, MAINTENANCE, ANNOUNCEMENT
  status  String // ACTIVE, RESOLVED, SCHEDULED

  scheduledStart DateTime?
  scheduledEnd   DateTime?

  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_status_entries")
}

model PlatformAlertRule {
  id            String @id @default(cuid())
  name          String
  metricType    String // ERROR_RATE, LATENCY, QUEUE_BACKLOG, DISK_USAGE
  condition     String // GT, LT, EQ
  threshold     Float
  periodMinutes Int    @default(5)

  channels  String[] // EMAIL, SMS, SLACK, WEBHOOK
  isEnabled Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_alert_rules")
}

// ==========================================
// Enterprise Reporting Module
// ==========================================

enum ReportCategory {
  FINANCIAL
  OPERATIONAL
  PLATFORM
  CUSTOM
}

model ReportTemplate {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  name        String
  description String?
  category    ReportCategory
  reportType  String // INCOME_STATEMENT, RENT_ROLL, etc.
  config      Json // Filters, columns, sorting

  isSystem    Boolean @default(false)
  isPublic    Boolean @default(false)
  isFavourite Boolean @default(false)

  createdById String
  creator     User   @relation("ReportCreator", fields: [createdById], references: [id])

  scheduledReports ScheduledReport[]
  savedReports     SavedReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([category])
  @@map("report_templates")
}

model SavedReport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  templateId String?
  template   ReportTemplate? @relation(fields: [templateId], references: [id])

  name    String
  filters Json
  data    Json? // Static data snapshot if cached

  createdById String
  creator     User   @relation("SavedReportCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("saved_reports")
}

model ScheduledReport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  templateId String
  template   ReportTemplate @relation(fields: [templateId], references: [id])

  frequency  String // DAILY, WEEKLY, MONTHLY, QUARTERLY
  cron       String?
  recipients String[] // Email addresses

  lastRunAt DateTime?
  nextRunAt DateTime?
  status    String    @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED

  executions ReportExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([nextRunAt])
  @@map("scheduled_reports")
}

model ReportExecution {
  id                String          @id @default(cuid())
  scheduledReportId String
  scheduledReport   ScheduledReport @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)

  status       String // SUCCESS, FAILED
  errorMessage String?
  duration     Int? // in ms
  outputUrl    String? // Link to generated PDF/Excel

  createdAt DateTime @default(now())

  @@index([scheduledReportId])
  @@map("report_executions")
}

model ReportExport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  reportType String
  format     String // PDF, XLSX, CSV
  status     String @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED

  filters     Json?
  downloadUrl String?
  expiresAt   DateTime?

  createdById String
  creator     User   @relation("ReportExportCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@map("report_exports")
}

model CollectionSetting {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Collections Reminders
  gracePeriod       Int      @default(0)
  upcomingDueDays   String   @default("5,3,1") // Comma separated
  overdueDays       String   @default("1,3,7,14,30") // Comma separated
  autoEscalateAfter Int      @default(60)

  // Outstanding balance SMS
  enableBalanceSms Boolean @default(false)
  firstSendDay     Int     @default(16)
  repeatEvery      Int     @default(3)
  smsTemplate      String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("collection_settings")
}
